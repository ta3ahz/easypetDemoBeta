# --- easyPET backend env ---
# MongoDB connection string (Railway MongoDB plugin, or MongoDB Atlas).
MONGODB_URI=mongodb://localhost:27017/easypet

# Secret for signing JWTs (device tokens + panel sessions). Use a long random value.
JWT_SECRET=change-me-to-a-long-random-string

# Credits granted to a clinic when it first registers (demo convenience).
STARTER_CREDITS=10

# Seed admin (used by `npm run seed:admin`).
ADMIN_EMAIL=admin@easypet.local
ADMIN_PASSWORD=changeme

# Per-device offline recovery PIN salt. MUST stay unset (or exactly match) so the
# 8-digit recovery PINs match the firmware constant 'uribx-recovery-2026'.
# RECOVERY_SALT=uribx-recovery-2026
